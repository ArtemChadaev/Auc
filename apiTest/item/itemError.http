Authorization: Bearer {{auth_token}}
Content-Type: application/json
Accept: application/json

{
  "filename": "overflow.jpg",
  "file_size": 999999999999999999,
  "sha_256_hex": "6ec3e443ba2ca8f12cabf1a7f8e6820c8d5b95f13dca636b0ae39d63ae21d25a"
}

> {%
    client.test("Reject huge file size (400/413/422)", () => {
        client.assert(response.status >= 400 && response.status < 500, "Ожидалась ошибка 4xx, получен: " + response.status);
    });
%}

