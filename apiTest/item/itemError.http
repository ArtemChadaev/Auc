> {%
    client.test("Handle non-existent status key (404/400)", () => {
        client.assert(response.status === 404 || response.status === 400, "Ожидался 404/400, получен: " + response.status);
    });
%}

### 7.4 SQL Injection в параметре key
GET {{host}}/api/upload/status?key=' UNION SELECT NULL--
Authorization: Bearer {{auth_token}}
Accept: application/json

> {%
    client.test("Reject SQLi in status query key without 500", () => {
        client.assert(response.status !== 500, "Сервер не должен выдавать 500");
    });
%}

