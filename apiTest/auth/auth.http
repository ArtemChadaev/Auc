###
POST http://localhost:8080/api/auth/refresh

> ../handler.js
###
POST localhost:8080/api/auth/logout
Authorization:Bearer {{auth_token}}
Accept: application/json

{
    "refresh_id": [6, 7, 8, 9]
}
###
POST localhost:8080/api/auth/session
Authorization:Bearer {{auth_token}}
Accept: application/json

{
    "current": true
}

###
GET localhost:8080/api/user/me
Authorization:Bearer {{auth_token}}

###
