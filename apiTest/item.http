### Переменные окружения
@host = http://localhost:8080

###############################################################################
# 1. Запрос Presigned URL для файла file.jpg (fail.jpg)
# Размер: 4727 байт
# SHA-256: 6ec3e443ba2ca8f12cabf1a7f8e6820c8d5b95f13dca636b0ae39d63ae21d25a
# Передаем filename сразу!
###############################################################################
POST {{host}}/api/upload/url
Authorization: Bearer {{auth_token}}
Content-Type: application/json
Accept: application/json

{
  "file_size": 4727,
  "sha_256_hex": "6ec3e443ba2ca8f12cabf1a7f8e6820c8d5b95f13dca636b0ae39d63ae21d25a",
  "filename": "file.jpg"
}

> {%
    client.test("Status code is 200 OK", function() {
        client.assert(response.status === 200, "Expected 200 OK, got: " + response.status);
    });

    client.test("Response body contains url and valid UUID key", function() {
        client.assert(response.body.data && response.body.data.url && typeof response.body.data.url === "string", "Missing or invalid 'url'");
        client.assert(response.body.data && response.body.data.key && typeof response.body.data.key === "string", "Missing or invalid 'key'");

        var uuidRegex = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
        client.assert(uuidRegex.test(response.body.data.key), "Key is not a valid UUID: " + response.body.data.key);
    });

    client.global.set("file_upload_url", response.body.data.url);
    client.global.set("file_upload_key", response.body.data.key);
%}

###

###############################################################################
# 2. Загрузка содержимого file.jpg в S3 по полученному Presigned URL
###############################################################################
PUT {{file_upload_url}}

< ./items/file.jpg

> {%
    client.test("S3 upload returned 200 OK", function() {
        client.assert(response.status === 200, "Expected status 200 from S3, got: " + response.status);
    });
%}

###

###############################################################################
# 3. Подтверждение загрузки: POST /api/upload/confirm
# Кидаем ключ в Header X-Upload-Key
# Проверяется капля (первые 512 байт), тип и размер файла
###############################################################################
POST {{host}}/api/upload/confirm
Authorization: Bearer {{auth_token}}
X-Upload-Key: {{file_upload_key}}
Accept: application/json

> {%
    client.test("Status code is 202 Accepted", function() {
        client.assert(response.status === 202, "Expected 202 Accepted, got: " + response.status);
    });
%}

###

###############################################################################
# 4. Проверка статуса обработки: GET /api/upload/status
# Поллинг каждые 5 секунд пока статус не станет "completed"
###############################################################################
GET {{host}}/api/upload/status?key={{file_upload_key}}
Authorization: Bearer {{auth_token}}
Accept: application/json

> {%
    client.test("Status code is 200 OK", function() {
        client.assert(response.status === 200, "Expected 200 OK, got: " + response.status);
    });
    if (response.body.data && response.body.data.status === "completed" && response.body.data.item) {
        client.global.set("created_item_id", response.body.data.item.id);
    }
%}

###

###############################################################################
# 5. Скачивание файла: GET /api/item/{id}/download
# Доступно только владельцу, не более 1 раза в сутки, пока не прошло 14 дней
###############################################################################
GET {{host}}/api/item/{{created_item_id}}/download
Authorization: Bearer {{auth_token}}
Accept: application/json

> {%
    client.test("Status code is 200 OK", function() {
        client.assert(response.status === 200, "Expected 200 OK, got: " + response.status);
    });
    client.test("Response contains download url", function() {
        client.assert(response.body.data && response.body.data.url, "Missing download url");
    });
%}

###

###############################################################################
# ТЕСТЫ ОШИБОК (VALIDATION & ERROR CODES)
###############################################################################

# 6. Ошибка 400: Неизвестные поля в JSON (unknown field)
POST {{host}}/api/upload/url
Authorization: Bearer {{auth_token}}
Content-Type: application/json
Accept: application/json

{
  "file_size": 4727,
  "sha_256_hex": "6ec3e443ba2ca8f12cabf1a7f8e6820c8d5b95f13dca636b0ae39d63ae21d25a",
  "filename": "file.jpg",
  "extra_unexpected_field": "test"
}

> {%
    client.test("Status code is 400 Bad Request", function() {
        client.assert(response.status === 400, "Expected 400, got: " + response.status);
    });
%}

###

# 7. Ошибка 400: Размер файла равен 0 (file size <= 0)
POST {{host}}/api/upload/url
Authorization: Bearer {{auth_token}}
Content-Type: application/json
Accept: application/json

{
  "file_size": 0,
  "sha_256_hex": "6ec3e443ba2ca8f12cabf1a7f8e6820c8d5b95f13dca636b0ae39d63ae21d25a",
  "filename": "file.jpg"
}

> {%
    client.test("Status code is 400 Bad Request", function() {
        client.assert(response.status === 400, "Expected 400, got: " + response.status);
    });
%}

###

# 8. Ошибка 400: Длина sha256 != 64 символов
POST {{host}}/api/upload/url
Authorization: Bearer {{auth_token}}
Content-Type: application/json
Accept: application/json

{
  "file_size": 4727,
  "sha_256_hex": "6ec3e443ba2ca8f12cabf1a7f8e6820c",
  "filename": "file.jpg"
}

> {%
    client.test("Status code is 400 Bad Request", function() {
        client.assert(response.status === 400, "Expected 400, got: " + response.status);
    });
%}

###

# 9. Ошибка 413: file_size превышает лимит
POST {{host}}/api/upload/url
Authorization: Bearer {{auth_token}}
Content-Type: application/json
Accept: application/json

{
  "file_size": 10737418241,
  "sha_256_hex": "6ec3e443ba2ca8f12cabf1a7f8e6820c8d5b95f13dca636b0ae39d63ae21d25a",
  "filename": "file.jpg"
}

> {%
    client.test("Status code is 413 Payload Too Large", function() {
        client.assert(response.status === 413, "Expected 413, got: " + response.status);
    });
%}
