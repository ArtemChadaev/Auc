# 9. Ошибка 400: Длина sha256 != 64 символов
POST {{host}}/api/upload/url
Content-Type: application/json
Accept: application/json

{
  "file_size": 4727,
  "sha_256_hex": "6ec3e443ba2ca8f12cabf1a7f8e6820c"
}

> {%
    client.test("Status code is 400 Bad Request", function() {
        client.assert(response.status === 400, "Expected 400, got: " + response.status);
    });
    client.test("Error message is 'invalid sha256 hash'", function() {
        client.assert(response.body.error === "invalid sha256 hash", "Expected 'invalid sha256 hash', got: " + response.body.error);
    });
%}

###

# 10. Ошибка 400: Невалидный hex формат SHA-256 (64 символа, но содержит не-hex знаки)
POST {{host}}/api/upload/url
Content-Type: application/json
Accept: application/json

{
  "file_size": 4727,
  "sha_256_hex": "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"
}

> {%
    client.test("Status code is 400 Bad Request", function() {
        client.assert(response.status === 400, "Expected 400, got: " + response.status);
    });
    client.test("Error message is 'invalid sha256 hex format'", function() {
        client.assert(response.body.error === "invalid sha256 hex format", "Expected 'invalid sha256 hex format', got: " + response.body.error);
    });
%}

###

# 11. Ошибка 413: file_size превышает 10 ГБ (10737418240 байт)
POST {{host}}/api/upload/url
Content-Type: application/json
Accept: application/json

{
  "file_size": 10737418241,
  "sha_256_hex": "6ec3e443ba2ca8f12cabf1a7f8e6820c8d5b95f13dca636b0ae39d63ae21d25a"
}

> {%
    client.test("Status code is 413 Payload Too Large", function() {
        client.assert(response.status === 413, "Expected 413, got: " + response.status);
    });
    client.test("Error message is 'request entity too large'", function() {
        client.assert(response.body.error === "request entity too large", "Expected 'request entity too large', got: " + response.body.error);
    });
%}
