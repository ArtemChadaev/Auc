###############################################################################
# ТЕСТЫ ОШИБОК (VALIDATION & ERROR CODES)
###############################################################################

# 5. Ошибка 400: Неизвестные поля в JSON (unknown field)
POST {{host}}/api/upload/url
Content-Type: application/json
Accept: application/json

{
  "file_size": 4727,
  "sha_256_hex": "6ec3e443ba2ca8f12cabf1a7f8e6820c8d5b95f13dca636b0ae39d63ae21d25a",
  "extra_unexpected_field": "test"
}

> {%
    client.test("Status code is 400 Bad Request", function() {
        client.assert(response.status === 400, "Expected 400, got: " + response.status);
    });
    client.test("Error message is 'invalid request body'", function() {
        client.assert(response.body.error === "invalid request body", "Expected 'invalid request body', got: " + response.body.error);
    });
%}

###

# 6. Ошибка 400: Невалидный синтаксис JSON
POST {{host}}/api/upload/url
Content-Type: application/json
Accept: application/json

{
  "file_size": 4727,
  "sha_256_hex":
}

> {%
    client.test("Status code is 400 Bad Request", function() {
        client.assert(response.status === 400, "Expected 400, got: " + response.status);
    });
%}

