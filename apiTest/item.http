###

###############################################################################
# 4. Загрузка содержимого rufus-4.15.exe в S3 по полученному Presigned URL
###############################################################################
PUT {{rufus_upload_url}}

< ./items/rufus-4.15.exe

> {%
    client.test("S3 upload returned 200 OK", function() {
