  "sha_256_hex": "6ec3e443ba2ca8f12cabf1a7f8e6820c8d5b95f13dca636b0ae39d63ae21d25a"
}

> {%
    client.test("Status code is 400 Bad Request", function() {
        client.assert(response.status === 400, "Expected 400, got: " + response.status);
    });
    client.test("Error message is 'file size must be greater than 0'", function() {
        client.assert(response.body.error === "file size must be greater than 0", "Expected 'file size must be greater than 0', got: " + response.body.error);
    });
%}

