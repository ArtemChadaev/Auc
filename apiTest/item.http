{
  "file_size": 1989992,
  "sha_256_hex": "84c8a437f8af89257524478489e5c85f1edf25f761d299e2bcde46ac0afbe106"
}

> {%
    client.test("Status code is 200 OK", function() {
        client.assert(response.status === 200, "Expected 200 OK, got: " + response.status);
    });

    client.test("Response body contains url and valid UUID key", function() {
        client.assert(response.body.data && response.body.data.url && typeof response.body.data.url === "string", "Missing or invalid 'url'");
        client.assert(response.body.data && response.body.data.key && typeof response.body.data.key === "string", "Missing or invalid 'key'");

        var uuidRegex = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
