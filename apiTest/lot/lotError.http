### 4.1 Создание лота с принудительным статусом 'active' (обход модерации)
POST {{host}}/api/lot/
Authorization: Bearer {{victim_token}}
Content-Type: application/json
Accept: application/json

{
  "title": "Попытка мгновенной активации в обход админа",
  "description": {
    "short_text": "Bypass status",
    "text": "Bypass review attempt",
    "type": "image"
  },
  "item_id": 1,
  "start_amount": 1000,
  "min_step": 100,
  "started_at": "{{target_start_at}}",
  "ends_at": "{{target_end_at}}",
  "status": "active"
}

> {%
    client.test("Prevent bypassing admin review via status injection", () => {
        if (response.status === 201) {
            client.assert(response.body.data.status !== "active", "КРИТИЧЕСКАЯ УЯЗВИМОСТЬ: Лот создан сразу в статусе active без одобрения!");
        } else {
            client.assert(response.status === 400 || response.status === 422, "Ожидалась ошибка 400/422, получен: " + response.status);
        }
    });
%}

### 4.2 Создание лота с инъекцией 'winner_id' (попытка мгновенной победы)
POST {{host}}/api/lot/
Authorization: Bearer {{victim_token}}
Content-Type: application/json
Accept: application/json

{
  "title": "Попытка назначения победителя при создании",
  "description": {
    "short_text": "Winner inject",
    "text": "Winner injection attempt",
    "type": "image"
  },
  "item_id": 1,
  "start_amount": 1000,
  "min_step": 100,
  "started_at": "{{target_start_at}}",
  "ends_at": "{{target_end_at}}",
  "status": "draft",
  "winner_id": "hacker_uuid_12345",
  "finish_amount": 999999
}

> {%
    client.test("Prevent mass assignment of winner_id and finish_amount", () => {
        if (response.status === 201) {
            client.assert(!response.body.data.winner_id, "КРИТИЧЕСКАЯ УЯЗВИМОСТЬ: winner_id был внедрен на создании!");
        } else {
            client.assert(response.status >= 400, "Ожидалась ошибка валидации");
        }
    });
%}

### 4.3 Создание лота с подделкой 'seller_id' (попытка создать лот от имени другого юзера/админа)
