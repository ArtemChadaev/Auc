### 10.3 Проверка приватности: Публичный список GET /api/lot/ не должен содержать чужие черновики
GET {{host}}/api/lot/
Accept: application/json

> {%
    client.test("Public lots list only includes active/finished lots", () => {
        client.assert(response.status === 200, "Expected status 200");
        if (Array.isArray(response.body.data)) {
            let hasDrafts = response.body.data.some(l => l.status === "draft" || l.status === "pending_review");
            client.assert(!hasDrafts, "УТЕЧКА ДАННЫХ: В публичном списке найдены лоты со статусом draft или pending_review!");
        }
    });
%}

