### 0.6 Инициализация тестового лота жертвы для атак (Создание лота pending_review с lot.Description)
< {%
    let now = new Date();
    let start = new Date(now.getTime() + 1000 * 60 * 180);
    let end = new Date(now.getTime() + 1000 * 60 * 60 * 48);
    client.global.set("target_start_at", start.toISOString());
    client.global.set("target_end_at", end.toISOString());
%}
POST {{host}}/api/lot/
Authorization: Bearer {{victim_token}}
Content-Type: application/json
Accept: application/json

{
  "title": "Целевой лот жертвы для проверок безопасности",
  "description": {
    "short_text": "Целевой лот для секьюрити тестов",
    "text": "Изначальный ценный лот с полным валидным описанием",
    "type": "image",
    "tags": ["security", "test", "audit"],
    "photo": ["initial_proof.jpg"],
    "auto_activate": false,
    "auto_active": false
  },
  "item_id": 1,
  "start_amount": 10000,
  "min_step": 1000,
  "started_at": "{{target_start_at}}",
  "ends_at": "{{target_end_at}}",
  "status": "pending_review",
  "auto_activate": false
}

> {%
    if (response.status === 201 && response.body.data && response.body.data.id) {
        client.global.set("target_lot_id", response.body.data.id);
    } else {
        client.global.set("target_lot_id", 1);
    }
%}

### 1.1 Попытка эскалации: Обычный пользователь пытается сам одобрить свой лот
POST {{host}}/api/lot/{{target_lot_id}}/approved
Authorization: Bearer {{victim_token}}
Accept: application/json

> {%
    client.test("Reject non-admin approval attempt (403 Forbidden)", () => {
        client.assert(response.status === 403, "Ожидался статус 403 Forbidden при попытке обычного юзера одобрить лот, получен: " + response.status);
    });
%}

