### 1.10 Повторное одобрение администратором уже одобренного лота (State Machine Violation)
POST {{host}}/api/lot/{{target_lot_id}}/approved
Authorization: Bearer {{admin_token}}
Accept: application/json

> {%
    client.test("Reject duplicate approval on already approved lot (400 Bad Request)", () => {
        client.assert(response.status === 400 || response.status === 409, "Ожидалась ошибка 400/409 при повторном одобрении, получен: " + response.status);
    });
%}

### 2.1 IDOR Атака: Атакующий пытается изменить параметры чужого лота (PUT /api/lot/{id})
PUT {{host}}/api/lot/{{target_lot_id}}
Authorization: Bearer {{attacker_token}}
Content-Type: application/json
Accept: application/json

{
  "title": "ХАКНУТЫЙ ЛОТ: Цена 1 рубль",
  "description": {
    "short_text": "ХАКНУТЫЙ ЛОТ",
    "text": "Попытка подмены описания через IDOR",
    "type": "image",
    "tags": ["hacked"],
    "photo": ["hacked.jpg"],
    "auto_activate": false,
    "auto_active": false
  },
  "item_id": 1,
  "start_amount": 1,
  "min_step": 1,
  "started_at": "{{target_start_at}}",
  "ends_at": "{{target_end_at}}",
  "status": "draft",
  "auto_activate": false
}

> {%
    client.test("Block IDOR lot modification by stranger (403/404)", () => {
        client.assert(response.status === 403 || response.status === 404, "Чужой пользователь не должен менять лот! Ожидался 403/404, получен: " + response.status);
    });
%}

