}

> {%
    client.test("Prevent spoofing seller_id", () => {
        if (response.status === 201) {
            client.assert(response.body.data.seller_id !== "00000000-0000-0000-0000-000000000001", "КРИТИЧЕСКАЯ УЯЗВИМОСТЬ: seller_id был подделан!");
        } else {
            client.assert(response.status >= 400, "Ожидалась ошибка");
        }
    });
%}

