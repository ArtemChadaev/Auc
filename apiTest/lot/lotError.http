# BLACK-BOX ADVERSARIAL & SECURITY TEST SUITE: AUCTION LOT API
# Сгенерировано строго по docs/swagger.yaml и http-client.env.json

### 0.1 Регистрация обычного пользователя (Жертва / Создатель лота)
< {%
    let ts = Date.now();
    client.global.set("victim_email", "victim_" + ts + "@security.test");
    client.global.set("victim_pass", "VictimPass123!");
%}
POST {{host}}/api/auth/register
Content-Type: application/json
Accept: application/json

{
  "name": "Victim User",
  "email": "{{victim_email}}",
  "password": "{{victim_pass}}"
}

### 0.2 Вход обычного пользователя (сохранение victim_token)
POST {{host}}/api/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "{{victim_email}}",
  "password": "{{victim_pass}}"
}

> {%
    client.test("Victim user login 200 OK", () => {
        client.assert(response.status === 200, "Expected status 200");
    });
    client.global.set("victim_token", response.body.data.access_token);
    client.global.set("auth_token", response.body.data.access_token);
%}

### 0.3 Вход администратора (проверка кредов из http-client.env.json)
POST {{host}}/api/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "{{adminemail}}",
  "password": "{{adminpass}}"
}

> {%
    client.test("Admin login 200 OK", () => {
        client.assert(response.status === 200, "Expected 200 for admin login");
        client.assert(response.body.data.access_token, "Admin access token required");
    });
    client.global.set("admin_token", response.body.data.access_token);
%}

