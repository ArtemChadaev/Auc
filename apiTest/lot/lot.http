### 5.1 Размещение ставки покупателем на активный лот (POST /api/bid/{id})
< {%
    client.global.set("bid_idempotency_key", "bid_key_" + Date.now());
%}
POST {{host}}/api/bid/{{active_flow_lot_id}}
Authorization: Bearer {{bidder_token}}
Content-Type: application/json
Accept: application/json

{
  "amount": 15000,
  "idempotency_key": "{{bid_idempotency_key}}"
}

> {%
    client.test("Bid response received", () => {
        client.assert(response.status === 200 || response.status === 400, "Expected status 200 or 400 (if insufficient balance), got: " + response.status);
    });
%}

