# E2E TEST SUITE: AUCTION LOT API (HAPPY PATH & LIFECYCLE)
# Сгенерировано строго по docs/swagger.yaml и http-client.env.json

### 1.1 Вход продавца из http-client.env.json (получение seller_token)
POST {{host}}/api/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "{{seller_email}}",
  "password": "{{seller_password}}"
}

> {%
    client.test("Seller logged in successfully", () => {
        client.assert(response.status === 200, "Expected status 200, got: " + response.status);
        client.assert(response.body.data && response.body.data.access_token, "access_token not found in seller login response");
    });
    client.global.set("seller_token", response.body.data.access_token);
    client.global.set("user_token", response.body.data.access_token);
    client.global.set("auth_token", response.body.data.access_token);
%}

### 1.2 Вход администратора из http-client.env.json (получение admin_token)
POST {{host}}/api/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "{{adminemail}}",
  "password": "{{adminpass}}"
}

> {%
    client.test("Admin logged in successfully", () => {
        client.assert(response.status === 200, "Expected status 200 for admin login, got: " + response.status);
        client.assert(response.body.data && response.body.data.access_token, "admin access_token not found");
    });
    client.global.set("admin_token", response.body.data.access_token);
%}

### 1.3 Вход покупателя из http-client.env.json (получение bidder_token)
POST {{host}}/api/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "{{bidder_email}}",
  "password": "{{bidder_password}}"
}

> {%
    client.test("Bidder logged in successfully", () => {
        client.assert(response.status === 200, "Expected status 200, got: " + response.status);
        client.assert(response.body.data && response.body.data.access_token, "bidder access_token not found");
    });
    client.global.set("bidder_token", response.body.data.access_token);
%}

### 2.1 Проверка доступа к прикрепленному файлу предмета продавца (GET /api/item/{id}/download)
GET {{host}}/api/item/{{seller_item_id}}/download
Authorization: Bearer {{seller_token}}
Accept: application/json

> {%
    client.test("Item download URL received or rate limited", () => {
        client.assert(response.status === 200 || response.status === 429, "Expected status 200 or 429 (daily limit), got: " + response.status);
    });
%}

### 3.1 Создание лота со статусом draft (черновик с валидным lot.Description)
< {%
    let now = new Date();
    let startTime = new Date(now.getTime() + 1000 * 60 * 120);
    let endTime = new Date(now.getTime() + 1000 * 60 * 60 * 48);
    client.global.set("draft_start_at", startTime.toISOString());
    client.global.set("draft_end_at", endTime.toISOString());
%}
POST {{host}}/api/lot/
Authorization: Bearer {{seller_token}}
Content-Type: application/json
Accept: application/json

{
  "title": "Черновик коллекционного лота",
  "description": {
    "short_text": "Краткое описание черновика лота",
    "text": "Подробное развернутое описание черновика лота в идеальном коллекционном состоянии.",
    "type": "image",
    "tags": [
      "collectibles",
      "vintage",
      "art"
    ],
    "photo": [
      "{{seller_filename}}"
    ],
    "auto_activate": false
  },
  "item_id": {{seller_item_id}},
  "start_amount": 5000,
  "min_step": 500,
  "started_at": "{{draft_start_at}}",
  "ends_at": "{{draft_end_at}}",
  "status": "draft"
}

> {%
    client.test("Draft lot created successfully (201 Created)", () => {
        client.assert(response.status === 201, "Expected status 201, got: " + response.status);
        client.assert(response.body.data && response.body.data.id, "Lot ID missing in response");
    });
    if (response.body.data && response.body.data.id) {
        client.global.set("draft_lot_id", response.body.data.id);
    }
%}

### 3.2 Создание лота со статусом pending_review (на модерацию администратору)
< {%
    let now = new Date();
    let startTime = new Date(now.getTime() + 1000 * 60 * 180);
    let endTime = new Date(now.getTime() + 1000 * 60 * 60 * 72);
    client.global.set("lot_start_at", startTime.toISOString());
    client.global.set("lot_end_at", endTime.toISOString());
%}
POST {{host}}/api/lot/
Authorization: Bearer {{seller_token}}
Content-Type: application/json
Accept: application/json

{
  "title": "Уникальный аукционный лот #1",
  "description": {
    "short_text": "Эксклюзивный редкий экспонат",
    "text": "Оригинальный экспонат в идеальном состоянии, сертифицирован экспертами.",
    "type": "image",
    "tags": [
      "rare",
      "masterpiece",
      "certified"
    ],
    "photo": [
      "{{seller_filename}}"
    ],
    "auto_activate": false
  },
  "item_id": {{seller_item_id}},
  "start_amount": 10000,
  "min_step": 500,
  "started_at": "{{lot_start_at}}",
  "ends_at": "{{lot_end_at}}",
  "status": "pending_review"
}

> {%
    client.test("Pending review lot created successfully (201 Created)", () => {
        client.assert(response.status === 201, "Expected status 201, got: " + response.status);
        client.assert(response.body.data && response.body.data.id, "Lot ID missing in response");
    });
    if (response.body.data && response.body.data.id) {
        client.global.set("active_flow_lot_id", response.body.data.id);
    }
%}

### 3.3 Обновление параметров лота продавцом (PUT /api/lot/{id} с lot.Description)
PUT {{host}}/api/lot/{{active_flow_lot_id}}
Authorization: Bearer {{seller_token}}
Content-Type: application/json
Accept: application/json

{
  "title": "Уникальный аукционный лот #1 (Обновленное название)",
  "description": {
    "short_text": "Обновленное краткое описание экспоната",
    "text": "Обновленное расширенное описание предмета с детальным списком характеристик и сертификатом подлинности.",
    "type": "image",
    "tags": [
      "rare",
      "masterpiece",
      "certified",
      "updated"
    ],
    "photo": [
      "{{seller_filename}}"
    ],
    "auto_activate": false
  },
  "item_id": {{seller_item_id}},
  "start_amount": 12000,
  "min_step": 500,
  "started_at": "{{lot_start_at}}",
  "ends_at": "{{lot_end_at}}",
  "status": "pending_review"
}

> {%
    client.test("Lot updated by seller successfully (200 OK)", () => {
        client.assert(response.status === 200, "Expected status 200, got: " + response.status);
    });
%}

### 3.4 Просмотр информации о лоте по ID (GET /api/lot/{id})
GET {{host}}/api/lot/{{active_flow_lot_id}}
Accept: application/json

> {%
    client.test("Get lot by ID successfully (200 OK)", () => {
        client.assert(response.status === 200, "Expected status 200, got: " + response.status);
        client.assert(response.body.data && response.body.data.id === client.global.get("active_flow_lot_id"), "Returned lot ID mismatch");
    });
%}

### 3.5 Просмотр списка своих лотов текущим продавцом (GET /api/lot/my)
GET {{host}}/api/lot/my
Authorization: Bearer {{seller_token}}
Accept: application/json

> {%
    client.test("Get my lots list successfully (200 OK)", () => {
        client.assert(response.status === 200, "Expected status 200, got: " + response.status);
        client.assert(Array.isArray(response.body.data), "Expected data to be an array of lots");
    });
%}

