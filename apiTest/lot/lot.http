### 4.2 Активация одобренного лота продавцом для старта торгов (POST /api/lot/{id}/activate)
< {%
    let now = new Date();
    let immediateStart = new Date(now.getTime() - 1000 * 10);
    let endsSoon = new Date(now.getTime() + 1000 * 60 * 60 * 24);
    client.global.set("active_started_at", immediateStart.toISOString());
    client.global.set("active_ends_at", endsSoon.toISOString());
%}
POST {{host}}/api/lot/{{active_flow_lot_id}}/activate
Authorization: Bearer {{seller_token}}
Content-Type: application/json
Accept: application/json

{
  "started_at": "{{active_started_at}}",
  "ends_at": "{{active_ends_at}}"
}

> {%
    client.test("Seller successfully activated approved lot (200 OK)", () => {
        client.assert(response.status === 200, "Expected status 200 OK on activate, got: " + response.status);
    });
%}

