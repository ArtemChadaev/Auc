# ==============================================================================
# TEST SUITE: DOCUMENTS & USER CONSENTS API (/api/documents)
# Включает позитивные сценарии и негативные / граничные проверки.
# ==============================================================================

### 1.1 Получение списка документов (Позитивный сценарий)
GET {{host}}/api/documents/
Accept: application/json

> {%
    client.test("List documents successfully (200)", () => {
        client.assert(response.status === 200, "Ожидался статус 200 OK, получен: " + response.status);
    });
%}

### 1.2 Получение активного документа по имени (Позитивный сценарий)
GET {{host}}/api/documents/name/terms-of-service
Accept: application/json

> {%
    client.test("Get document by name successfully (200)", () => {
        client.assert(response.status === 200, "Ожидался статус 200 OK, получен: " + response.status);
    });
%}

### 1.3 Получение документа по несуществующему имени (404)
GET {{host}}/api/documents/name/non_existent_document_name_xyz
Accept: application/json

> {%
    client.test("Document not found by name (404)", () => {
        client.assert(response.status === 404, "Ожидался статус 404 Not Found, получен: " + response.status);
    });
%}

### 1.4 Получение документа по имени: проверка на SQL Injection
GET {{host}}/api/documents/name/' OR 1=1--
Accept: application/json

> {%
    client.test("Handle SQL injection in document name safely", () => {
        client.assert(response.status !== 500, "Сервер не должен падать с 500");
    });
%}

### 1.5 Получение документа по ID (Позитивный сценарий)
GET {{host}}/api/documents/3
Accept: application/json

> {%
    client.test("Get document by ID successfully (200)", () => {
        client.assert(response.status === 200, "Ожидался статус 200 OK, получен: " + response.status);
    });
%}

### 1.6 Получение документа по несуществующему ID (404)
GET {{host}}/api/documents/999999999
Accept: application/json

> {%
    client.test("Document not found by ID (404)", () => {
        client.assert(response.status === 404, "Ожидался статус 404 Not Found, получен: " + response.status);
    });
%}

### 1.7 Получение документа по нулевому ID (0)
GET {{host}}/api/documents/0
Accept: application/json

> {%
    client.test("Reject or not found on document_id = 0 (400/404)", () => {
        client.assert(response.status === 400 || response.status === 404, "Ожидался статус 400 или 404, получен: " + response.status);
    });
%}

### 1.8 Получение документа по отрицательному ID (-1)
GET {{host}}/api/documents/-1
Accept: application/json

> {%
    client.test("Reject or not found on negative document_id (400/404)", () => {
        client.assert(response.status === 400 || response.status === 404, "Ожидался статус 400 или 404, получен: " + response.status);
    });
%}

### 1.9 Получение документа по нечисловому ID (строка)
GET {{host}}/api/documents/invalid_id
Accept: application/json

> {%
    client.test("Reject non-numeric document_id (400/404)", () => {
        client.assert(response.status === 400 || response.status === 404, "Ожидался статус 400 или 404, получен: " + response.status);
    });
%}

### 2.1 Создание согласия (Позитивный сценарий, положительный int64 document_id)
POST {{host}}/api/documents/consents
Authorization: Bearer {{auth_token}}
Content-Type: application/json
Accept: application/json

{
  "document_id": 3
}

> {%
    client.test("Consent created successfully (200/201)", () => {
        client.assert(response.status === 200 || response.status === 201, "Ожидался статус 200 или 201, получен: " + response.status);
    });
%}

### 2.2 Создание согласия: Запрос БЕЗ токена авторизации (401)
POST {{host}}/api/documents/consents
Content-Type: application/json
Accept: application/json

{
  "document_id": 3
}

> {%
    client.test("Reject unauthorized consent creation (401)", () => {
        client.assert(response.status === 401, "Ожидался статус 401 Unauthorized, получен: " + response.status);
    });
%}

### 2.3 Создание согласия: Поддельный токен авторизации (401)
POST {{host}}/api/documents/consents
Authorization: Bearer fake_invalid_jwt_token
Content-Type: application/json
Accept: application/json

{
  "document_id": 3
}

> {%
    client.test("Reject invalid token on consent creation (401)", () => {
        client.assert(response.status === 401, "Ожидался статус 401 Unauthorized, получен: " + response.status);
    });
%}

### 2.4 Создание согласия: Пустой JSON-объект {} (400/422)
POST {{host}}/api/documents/consents
Authorization: Bearer {{auth_token}}
Content-Type: application/json
Accept: application/json

{}

> {%
    client.test("Reject empty json body (400/422)", () => {
        client.assert(response.status >= 400 && response.status < 500, "Ожидалась ошибка 4xx, получен: " + response.status);
    });
%}

### 2.5 Создание согласия: Нулевой document_id (0)
POST {{host}}/api/documents/consents
Authorization: Bearer {{auth_token}}
Content-Type: application/json
Accept: application/json

{
  "document_id": 0
}

> {%
    client.test("Reject zero document_id (400/422)", () => {
        client.assert(response.status >= 400 && response.status < 500, "Ожидалась ошибка 4xx, получен: " + response.status);
    });
%}

### 2.6 Создание согласия: Отрицательный document_id (-1)
POST {{host}}/api/documents/consents
Authorization: Bearer {{auth_token}}
Content-Type: application/json
Accept: application/json

{
